# Configuração do deploy (scripts/deploy.ps1). Nenhum destes valores é segredo —
# a autenticação real fica no clasp (clasp login) e no gh (gh auth login), que guardam
# o próprio token fora deste projeto.

# Dono do repositório GitHub onde o PWA será publicado (usuário ou org)
DEPLOY_GITHUB_OWNER=grupofizz

# Nome do repositório GitHub a criar/usar para o GitHub Pages
DEPLOY_GITHUB_REPO=todo-rosamango

# Título da Google Planilha criada pelo clasp na primeira execução do deploy
DEPLOY_SHEET_TITLE=Grupo Fizz — TODO List
